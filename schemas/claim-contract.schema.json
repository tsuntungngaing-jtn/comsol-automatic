{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["claim_id", "observable", "validation_role"],
  "properties": {
    "claim_id": {"type": "string", "minLength": 1},
    "paper_source": {"type": "string"},
    "observable": {"type": "string"},
    "paper_value": {},
    "paper_unit": {"type": "string"},
    "paper_uncertainty": {},
    "simulation_expression": {"type": "string"},
    "dataset_requirement": {"type": "string"},
    "operating_condition": {},
    "comparison_method": {"type": "string"},
    "tolerance": {},
    "validation_role": {
      "enum": ["calibration", "validation", "qualitative_reference", "not_comparable"]
    }
  }
}
