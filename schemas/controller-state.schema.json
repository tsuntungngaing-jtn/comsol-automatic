{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["case_id", "workflow_state", "evidence_revision", "spec_revision", "model_revision", "budgets"],
  "properties": {
    "case_id": {"type": "string"},
    "workflow_state": {
      "enum": ["NEW", "EVIDENCE_INTAKE", "SPEC_COMPILATION", "WAITING_FOR_USER", "MODEL_BUILD", "PRECHECK", "SOLVE_READY", "SOLVING", "VALIDATION", "DIAGNOSIS", "REPAIR_READY", "REPAIRING", "REOPEN_VERIFY", "DELIVERY_READY", "PASS", "FAIL", "BLOCKED", "BUDGET_EXHAUSTED", "CALIBRATED_NOT_INDEPENDENTLY_VALIDATED"]
    },
    "evidence_revision": {"type": "integer", "minimum": 1},
    "spec_revision": {"type": "integer", "minimum": 1},
    "model_revision": {"type": "integer", "minimum": 1},
    "current_model_identity": {},
    "current_mph_path": {},
    "current_run_id": {},
    "study_id": {},
    "solver_id": {},
    "solution_id": {},
    "dataset_id": {},
    "accepted_assumptions": {"type": "array"},
    "pending_decisions": {"type": "array"},
    "invalidated_checks": {"type": "array"},
    "last_failure": {},
    "repair_history": {"type": "array"},
    "failed_baselines": {"type": "array"},
    "budgets": {"type": "object"},
    "timestamps": {"type": "object"}
  }
}
